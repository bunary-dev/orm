{
  "name": "@bunary/orm",
  "version": "0.4.0",
  "description": "Laravel-style models on Drizzle for Bunary - a Bun-first backend framework",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "default": "./dist/provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./src/index.ts ./src/provider.ts --outdir ./dist --target bun --splitting --packages external && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check ./src ./tests",
    "format": "biome check --write ./src ./tests",
    "pack:check": "bun pm pack --dry-run"
  },
  "keywords": [
    "bunary",
    "bun",
    "orm",
    "drizzle",
    "model",
    "database",
    "sqlite",
    "postgres",
    "framework"
  ],
  "author": "Paul Radford",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bunary-dev/orm.git"
  },
  "homepage": "https://github.com/bunary-dev/orm#readme",
  "bugs": {
    "url": "https://github.com/bunary-dev/orm/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "peerDependencies": {
    "@bunary/core": "^0.4.0",
    "drizzle-orm": "^0.45.0"
  },
  "peerDependenciesMeta": {
    "@bunary/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@bunary/core": "^0.4.0",
    "@types/bun": "^1.4.2",
    "drizzle-orm": "^0.45.4",
    "typescript": "^7.0.2"
  }
}
